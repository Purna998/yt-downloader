# ── Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

# Server port (default: 3001)
PORT=3001

# Node environment: "development" or "production"
NODE_ENV=production

# Allowed CORS origins (comma-separated, no spaces)
# For local dev: http://localhost:3001
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Rate limiting
# Maximum API requests per window per IP
RATE_LIMIT_MAX=100
# Rate limit window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# Logging
# Log level: "combined", "dev", "short", "tiny"
LOG_FORMAT=combined

# Optional: Netscape formatted YouTube cookies to bypass Datacenter IP blocks
# Export using "Get cookies.txt LOCALLY" extension and paste raw text here.
YOUTUBE_COOKIES=""
