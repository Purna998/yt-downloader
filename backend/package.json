{
  "name": "yt-downloader-backend",
  "version": "2.0.0",
  "description": "YTGrab – YouTube Video Downloader Backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "start:prod":  "NODE_ENV=production node server.js",
    "pm2:start":   "pm2 start ../ecosystem.config.js --env production",
    "pm2:stop":    "pm2 stop ytgrab",
    "pm2:restart": "pm2 restart ytgrab",
    "pm2:logs":    "pm2 logs ytgrab",
    "pm2:monit":   "pm2 monit"
  },
  "dependencies": {
    "compression":        "^1.8.0",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.7",
    "express":            "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet":             "^8.0.0",
    "morgan":             "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
